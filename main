<!-- ============ BARRA DE NAVEGACIÓN ============ -->
<nav aria-label="Navegación de diapositivas">
  <button id="btnPrev" class="btn-nav" aria-label="Diapositiva anterior">&#8249;</button>
  <div id="puntos" role="tablist" aria-label="Ir a diapositiva"></div>
  <span id="contador" aria-live="polite">1 / 1</span>
  <button id="btnNext" class="btn-nav" aria-label="Diapositiva siguiente">&#8250;</button>
</nav>
<p class="ayuda-teclado">Usa <kbd>←</kbd> <kbd>→</kbd> o <kbd>espacio</kbd></p>

<script>
/* ==================================================================
   LÓGICA DE NAVEGACIÓN (idéntica a la versión original):
   contador y puntos se generan según el nº de <section class="slide">.
   ================================================================== */
(function(){
  "use strict";

  var slides   = document.querySelectorAll(".slide");
  var btnPrev  = document.getElementById("btnPrev");
  var btnNext  = document.getElementById("btnNext");
  var contador = document.getElementById("contador");
  var puntosEl = document.getElementById("puntos");
  var actual   = 0;
  var total    = slides.length;

  for (var i = 0; i < total; i++){
    (function(idx){
      var p = document.createElement("button");
      p.className = "punto";
      p.setAttribute("aria-label", "Ir a la diapositiva " + (idx + 1));
      p.addEventListener("click", function(){ irA(idx); });
      puntosEl.appendChild(p);
    })(i);
  }
  var puntos = puntosEl.querySelectorAll(".punto");

  function irA(n){
    if (n < 0 || n >= total) return;
    slides[actual].classList.remove("activa");
    puntos[actual].classList.remove("activo");
    actual = n;
    slides[actual].classList.add("activa");
    puntos[actual].classList.add("activo");
    slides[actual].scrollTop = 0;
    contador.textContent = (actual + 1) + " / " + total;
    btnPrev.disabled = (actual === 0);
    btnNext.disabled = (actual === total - 1);
  }

  function siguiente(){ irA(actual + 1); }
  function anterior(){  irA(actual - 1); }

  btnNext.addEventListener("click", siguiente);
  btnPrev.addEventListener("click", anterior);

  document.addEventListener("keydown", function(e){
    if (e.key === "ArrowRight"){ e.preventDefault(); siguiente(); }
    else if (e.key === "ArrowLeft"){ e.preventDefault(); anterior(); }
    else if (e.key === " " || e.code === "Space"){
      if (document.activeElement && document.activeElement.tagName === "BUTTON") return;
      e.preventDefault(); siguiente();
    }
  });

  irA(0);
})();
</script>

</body>
</html>
